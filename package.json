{
  "name": "deliveries-simulator",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:types": "ngc -p tsconfig.spec.json --noEmit",
    "check:public-safety": "node scripts/check-public-safety.mjs",
    "check": "npm run check:public-safety && npm run check:format && npm run check:styles && npm run lint && npm run check:architecture && npm run check:types && npm run test:coverage && npm run test:e2e",
    "scenario": "node scripts/run-scenario.mjs",
    "benchmark": "node scripts/benchmark-city.mjs",
    "self-test": "node scripts/self-test.mjs",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:styles": "stylelint \"src/**/*.css\"",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "immutable": "5.1.9",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.5",
    "@analogjs/vitest-angular": "2.9.5",
    "@angular/build": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-jsdoc": "65.4.3",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
