root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 99

# npm writes these itself, with two spaces.
[{package.json,package-lock.json}]
indent_size = 2

# Document governance keeps Markdown under 100 characters too, and indents lists to their text.
[*.md]
indent_size = 2
max_line_length = 99
